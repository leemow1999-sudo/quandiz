# ----- Công cụ dịch -----
# claude  = chất lượng cao nhất, hiểu tiếng lóng buôn hàng 1688 (khuyên dùng)
# google  = miễn phí, không cần key, dịch máy thường
TRANSLATE_PROVIDER=claude
TRANSLATE_FALLBACK=google

# Lấy key tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Tuỳ chọn — để trống là dùng mặc định
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low          # low | medium | high — thấp thì nhanh và rẻ hơn
# ANTHROPIC_MAX_TOKENS=2000

# ----- Bảo vệ khi mở ra Internet -----
# Đặt mật khẩu thì ai vào app cũng phải nhập, khỏi bị người lạ xài chùa API key.
# Chạy ở máy nhà thì để trống cũng được.
APP_PASSCODE=

# ----- Máy chủ -----
# PORT=3000
# HOST=0.0.0.0
# CONTEXT_TURNS=6               # số tin gần nhất gửi kèm làm ngữ cảnh
# MAX_INPUT_CHARS=4000
# CACHE_SIZE=500

# ============================================================
# CHATBOT TRẢ LỜI KHÁCH TRÊN PANCAKE  (trang quản trị: /bot/)
# ============================================================
# Pancake → chọn page → Cài đặt → Công cụ → Page access token (API) → Tạo / Sao chép
PANCAKE_PAGE_ID=
PANCAKE_PAGE_ACCESS_TOKEN=
# Nhiều page thì dùng dòng này thay cho 2 dòng trên:
# PANCAKE_PAGES=page_id_1:token_1,page_id_2:token_2

# Chuỗi bí mật nằm trong URL webhook (Pancake không ký webhook). Tự đặt, ít nhất 16 ký tự,
# ví dụ tạo bằng: openssl rand -hex 16
PANCAKE_WEBHOOK_SECRET=

# off | shadow | auto
#   shadow = soạn câu trả lời và ghi nhật ký nhưng KHÔNG gửi — chạy thử trên khách thật trước
#   auto   = tự gửi cho khách (chỉ có hiệu lực khi bot/knowledge.md đã điền thông tin thật)
# Chỉnh được ngay trên trang /bot/ không cần khởi động lại.
BOT_MODE=shadow

# Tuỳ chọn — để trống là dùng mặc định
# BOT_MODEL=claude-opus-5-5
# BOT_EFFORT=low                  # low | medium | high — cao hơn thì kỹ hơn nhưng chậm và tốn hơn
# BOT_KNOWLEDGE_FILE=bot/knowledge.md
# BOT_REPLY_DELAY_SEC=6           # chờ khách gõ xong rồi trả lời một lượt
# BOT_HUMAN_PAUSE_MIN=120         # nhân viên nhắn tay thì bot im ở hội thoại đó bao lâu
# BOT_PAUSE_TAG=Cần nhân viên     # tên thẻ trên Pancake: bot gắn khi cần người; có thẻ này bot im
# BOT_HANDOFF_ASSIGN=             # id nhân viên Pancake được giao hội thoại khi bot chuyển, cách nhau dấu phẩy
# BOT_WRITE_NOTES=true            # ghi tóm tắt đơn / lý do chuyển vào ghi chú khách trên Pancake
# BOT_MAX_REPLIES_PER_HOUR=15     # mỗi hội thoại, chống lặp với bot khác
# BOT_READ_IMAGES=true            # cho bot xem ảnh khách gửi
# BOT_FALLBACKS=default           # model chính từ chối thì tự chuyển model dự phòng; "off" để tắt
# DATA_DIR=data                   # nơi lưu trạng thái + nhật ký của bot
