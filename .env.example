# ----- Công cụ dịch -----
# claude  = chất lượng cao nhất, hiểu tiếng lóng buôn hàng 1688 (khuyên dùng)
# google  = miễn phí, không cần key, dịch máy thường
TRANSLATE_PROVIDER=claude
TRANSLATE_FALLBACK=google

# Lấy key tại https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Tuỳ chọn — để trống là dùng mặc định
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=low          # low | medium | high — thấp thì nhanh và rẻ hơn
# ANTHROPIC_MAX_TOKENS=2000

# ----- Máy chủ -----
# PORT=3000
# HOST=0.0.0.0
# CONTEXT_TURNS=6               # số tin gần nhất gửi kèm làm ngữ cảnh
# MAX_INPUT_CHARS=4000
# CACHE_SIZE=500
